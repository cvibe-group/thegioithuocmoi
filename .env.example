# Supabase (project: iweejgtuyzdmdjdjmxiq)
NEXT_PUBLIC_SUPABASE_URL=https://iweejgtuyzdmdjdjmxiq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional (new API keys)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service role — bắt buộc để /admin/users tạo/sửa/xóa Auth users (không expose ra client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (sitemap / robots). On Vercel, falls back to VERCEL_URL.
NEXT_PUBLIC_SITE_URL=https://thegioithuocmoi.com

# CKEditor 5 (admin). Default GPL self-host if unset.
# NEXT_PUBLIC_CKEDITOR_LICENSE_KEY=GPL

# CMS roles (app_metadata.role): super_admin | editor | author | viewer
# Quản lý tại /admin/users (super_admin) hoặc Dashboard Auth → App Metadata
# Đăng nhập /admin/login — đăng xuất/đăng nhập lại sau khi đổi role
#
# Deploy: xem docs/DEPLOY.md (Docker compose là đường chính thức)
